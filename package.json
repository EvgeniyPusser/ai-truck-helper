{
  "name": "holy-move-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:server": "tsx watch server/index.js",
    "dev:client": "npm run dev --workspace frontend",
    "build:client": "npm run build --workspace frontend",
    "build": "tsc",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed:providers": "node scripts/seed-providers.js",
    "start": "node server/index.js",
    "dev": "tsx watch server/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^7.2.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
